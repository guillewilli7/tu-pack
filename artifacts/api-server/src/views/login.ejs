<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TuPack Admin — Iniciar sesión</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f0f4f8; min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
    }
    .login-wrapper { width: 100%; max-width: 400px; padding: 20px; }
    .login-brand { text-align: center; margin-bottom: 32px; }
    .login-brand h1 { font-size: 28px; font-weight: 800; color: #1a2332; letter-spacing: -0.5px; }
    .login-brand p { font-size: 14px; color: #718096; margin-top: 4px; }
    .login-card {
      background: #fff; border-radius: 12px; border: 1px solid #e2e8f0;
      padding: 32px; box-shadow: 0 4px 20px rgba(0,0,0,0.06);
    }
    .login-card h2 { font-size: 18px; font-weight: 600; color: #2d3748; margin-bottom: 24px; }
    .form-group { margin-bottom: 18px; }
    .form-label { display: block; font-size: 13px; font-weight: 500; color: #4a5568; margin-bottom: 6px; }
    .form-control {
      width: 100%; padding: 10px 14px; border: 1px solid #e2e8f0; border-radius: 8px;
      font-size: 14px; color: #2d3748; background: #fff; transition: border-color 0.15s;
    }
    .form-control:focus { outline: none; border-color: #4299e1; box-shadow: 0 0 0 3px rgba(66,153,225,0.15); }
    .btn-login {
      width: 100%; padding: 11px; background: #4299e1; color: #fff; border: none;
      border-radius: 8px; font-size: 15px; font-weight: 600; cursor: pointer;
      transition: background 0.15s; margin-top: 4px;
    }
    .btn-login:hover { background: #3182ce; }
    .alert-error {
      background: #fff5f5; border: 1px solid #fed7d7; color: #c53030;
      padding: 10px 14px; border-radius: 8px; font-size: 13px; margin-bottom: 20px;
    }
  </style>
</head>
<body>
  <div class="login-wrapper">
    <div class="login-brand">
      <h1>TuPack</h1>
      <p>Panel de Administración</p>
    </div>
    <div class="login-card">
      <h2>Iniciar sesión</h2>
      <% if (error) { %>
        <div class="alert-error"><%= error %></div>
      <% } %>
      <form method="POST" action="/auth/login">
        <div class="form-group">
          <label class="form-label" for="email">Correo electrónico</label>
          <input class="form-control" type="email" id="email" name="email" required autofocus placeholder="usuario@mail.com" />
        </div>
        <div class="form-group">
          <label class="form-label" for="password">Contraseña</label>
          <input class="form-control" type="password" id="password" name="password" required placeholder="••••••••" />
        </div>
        <button type="submit" class="btn-login">Entrar</button>
      </form>
    </div>
  </div>
</body>
</html>
