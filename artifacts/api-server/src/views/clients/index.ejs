<%- include('../partials/header', { title: 'Clientes', page: 'clients', nombre }) %>

<% if (success === 'deactivated') { %><div class="alert alert-success">Cliente desactivado correctamente.</div><% } %>
<% if (success && success !== 'deactivated') { %><div class="alert alert-success">Cambios guardados correctamente.</div><% } %>
<% if (error) { %><div class="alert alert-error">Error al realizar la acción. Intentá de nuevo.</div><% } %>

<div class="card section">
  <div class="card-header">
    <span class="card-title">Buscar</span>
  </div>
  <div class="card-body">
    <form method="GET" action="/clients">
      <div class="filter-bar">
        <div class="form-group" style="flex:1;min-width:220px;">
          <label class="form-label">Nombre del cliente</label>
          <input type="text" name="search" class="form-control" value="<%= search %>" placeholder="Buscar cliente..." />
        </div>
        <div class="form-group">
          <button type="submit" class="btn btn-primary">Buscar</button>
          <a href="/clients" class="btn btn-secondary" style="margin-left:8px;">Limpiar</a>
        </div>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <span class="card-title">Clientes (<%= clients.length %>)</span>
    <a href="/clients/new" class="btn btn-primary btn-sm">+ Nuevo cliente</a>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Cliente</th>
          <th style="width:110px;">Sucursales</th>
          <th style="width:110px;">Productos</th>
          <th style="width:150px;">Sin stock</th>
          <th style="width:100px;">Estado</th>
          <th style="width:70px;"></th>
        </tr>
      </thead>
      <tbody>
        <% if (!clients.length) { %>
          <tr><td colspan="6" class="table-empty">No se encontraron clientes.</td></tr>
        <% } %>
        <% clients.forEach(function(c) { %>
          <tr style="cursor:pointer;" onclick="window.location='/clients/<%= c.id %>'">
            <td><strong><%= c.nombre %></strong></td>
            <td><%= c.sucursales %></td>
            <td><%= c.productos %></td>
            <td>
              <% if (Number(c.sin_stock) > 0) { %>
                <span class="badge badge-red"><%= c.sin_stock %> sin stock</span>
              <% } else if (Number(c.productos) > 0) { %>
                <span class="badge badge-green">Al día</span>
              <% } else { %>
                <span class="text-muted">—</span>
              <% } %>
            </td>
            <td><span class="badge <%= c.activo ? 'badge-green' : 'badge-red' %>"><%= c.activo ? 'Activo' : 'Inactivo' %></span></td>
            <td onclick="event.stopPropagation()"><a href="/clients/<%= c.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
