<%- include('../partials/header', { title: 'Cliente: ' + client.negocio, page: 'clients', nombre }) %>

<div class="flex gap-2 items-center" style="margin-bottom:20px;">
  <a href="/clients" class="btn btn-secondary btn-sm">← Volver</a>
</div>

<% if (success) { %><div class="alert alert-success">Cambios guardados correctamente.</div><% } %>

<div class="card section">
  <div class="card-header"><span class="card-title">Datos del cliente</span></div>
  <div class="card-body">
    <form method="POST" action="/clients/<%= client.id %>/update">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Negocio</label>
          <input name="negocio" class="form-control" value="<%= client.negocio || '' %>" required />
        </div>
        <div class="form-group">
          <label class="form-label">Sucursal</label>
          <input name="sucursal" class="form-control" value="<%= client.sucursal || '' %>" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Razón social</label>
          <input name="razon_social" class="form-control" value="<%= client.razon_social || '' %>" />
        </div>
        <div class="form-group">
          <label class="form-label">RUT</label>
          <input name="rut" class="form-control" value="<%= client.rut || '' %>" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Dirección de facturación</label>
          <input name="direccion_facturacion" class="form-control" value="<%= client.direccion_facturacion || '' %>" />
        </div>
        <div class="form-group">
          <label class="form-label">Dirección de entrega</label>
          <input name="direccion_entrega" class="form-control" value="<%= client.direccion_entrega || '' %>" />
        </div>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Horario de entrega</label>
          <input name="horario_entrega" class="form-control" value="<%= client.horario_entrega || '' %>" />
        </div>
        <div class="form-group">
          <label class="form-label">Estado</label>
          <select name="activo" class="form-control">
            <option value="true" <%= client.activo ? 'selected' : '' %>>Activo</option>
            <option value="false" <%= !client.activo ? 'selected' : '' %>>Inactivo</option>
          </select>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </form>
  </div>
</div>

<div class="card section">
  <div class="card-header">
    <span class="card-title">Productos del cliente (<%= clientProducts.length %>)</span>
    <button class="btn btn-sm btn-primary" onclick="openAddProductModal()">+ Agregar producto</button>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Producto</th>
          <th>Costo</th>
          <th>Precio cliente</th>
          <th>Ratio</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!clientProducts.length) { %>
          <tr><td colspan="5" class="table-empty">No hay productos asignados.</td></tr>
        <% } %>
        <% clientProducts.forEach(function(p) { %>
          <tr>
            <td><strong><%= p.nombre %></strong> <span class="text-muted"><%= p.codigo_prod %></span></td>
            <td>$<%= Number(p.costo || 0).toFixed(2) %></td>
            <td>
              <form class="inline-form" method="POST" action="/clients/<%= client.id %>/products/update-price">
                <input type="hidden" name="cp_id" value="<%= p.cp_id %>" />
                <input type="number" name="precio_cliente" class="form-control" step="0.01" value="<%= Number(p.precio_cliente || 0).toFixed(2) %>" style="width:100px;" />
                <button type="submit" class="btn btn-sm btn-primary">OK</button>
              </form>
            </td>
            <td>
              <% const ratio = p.costo > 0 ? (p.precio_cliente / p.costo) : null; %>
              <span class="badge <%= ratio && ratio > 1 ? 'badge-blue' : 'badge-gray' %>">
                <%= ratio ? ratio.toFixed(2) + 'x' : '—' %>
              </span>
            </td>
            <td></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<div class="card section">
  <div class="card-header">
    <span class="card-title">Teléfonos (<%= phones.length %>)</span>
    <button class="btn btn-sm btn-primary" onclick="document.getElementById('add-phone-modal').classList.add('open')">+ Agregar teléfono</button>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Teléfono</th>
          <th>Etiqueta</th>
          <th>Estado</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!phones.length) { %>
          <tr><td colspan="4" class="table-empty">No hay teléfonos registrados.</td></tr>
        <% } %>
        <% phones.forEach(function(ph) { %>
          <tr>
            <td><strong><%= ph.phone %></strong></td>
            <td><%= ph.label || '—' %></td>
            <td><span class="badge <%= ph.activo ? 'badge-green' : 'badge-red' %>"><%= ph.activo ? 'Activo' : 'Inactivo' %></span></td>
            <td>
              <% if (ph.activo) { %>
                <form method="POST" action="/clients/<%= client.id %>/phones/<%= ph.id %>/deactivate" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Desactivar este teléfono?')">Desactivar</button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Embed product data as a hidden JSON script tag with safe escaping -->
<script id="products-data" type="application/json">
<%
  // Safely embed only the fields we need; EJS <%- %> is safe here because
  // JSON.stringify produces valid JSON with no unescaped HTML that can break
  // the script context — the type="application/json" tag is not executable.
  const safeProducts = allProducts.map(function(p) {
    return { id: p.id, nombre: p.nombre, codigo_prod: p.codigo_prod };
  });
%>
<%- JSON.stringify(safeProducts) %>
</script>

<!-- Add Product Modal with searchable dropdown (XSS-safe: DOM APIs only, no innerHTML) -->
<div class="modal-backdrop" id="add-product-modal">
  <div class="modal">
    <h3>Agregar producto</h3>
    <form method="POST" action="/clients/<%= client.id %>/products/add" id="add-product-form">
      <div class="form-group">
        <label class="form-label">Buscar producto</label>
        <input type="text" id="product-search-input" class="form-control" placeholder="Escribir nombre o código..." autocomplete="off" />
        <div id="product-dropdown" style="position:relative;">
          <div id="product-list" style="display:none;position:absolute;top:2px;left:0;right:0;background:#fff;border:1px solid #e2e8f0;border-radius:7px;box-shadow:0 4px 16px rgba(0,0,0,0.1);max-height:200px;overflow-y:auto;z-index:200;"></div>
        </div>
        <input type="hidden" name="product_id" id="selected-product-id" required />
        <div id="selected-product-label" style="margin-top:6px;font-size:13px;color:#4299e1;display:none;"></div>
      </div>
      <div class="form-group">
        <label class="form-label">Precio cliente ($)</label>
        <input type="number" name="precio_cliente" class="form-control" step="0.01" value="0" required />
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeAddProductModal()">Cancelar</button>
        <button type="submit" class="btn btn-primary">Agregar</button>
      </div>
    </form>
  </div>
</div>

<!-- Add Phone Modal -->
<div class="modal-backdrop" id="add-phone-modal">
  <div class="modal">
    <h3>Agregar teléfono</h3>
    <form method="POST" action="/clients/<%= client.id %>/phones/add">
      <div class="form-group">
        <label class="form-label">Número de teléfono</label>
        <input type="text" name="phone" class="form-control" placeholder="598 9X XXX XXX" required />
      </div>
      <div class="form-group">
        <label class="form-label">Etiqueta</label>
        <input type="text" name="label" class="form-control" placeholder="Principal, WhatsApp, etc." />
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('add-phone-modal').classList.remove('open')">Cancelar</button>
        <button type="submit" class="btn btn-primary">Guardar</button>
      </div>
    </form>
  </div>
</div>

<script>
  // Parse product list from the safe JSON script tag — no inline data injection
  var allProducts = JSON.parse(document.getElementById('products-data').textContent);

  // Close modal on backdrop click
  document.querySelectorAll('.modal-backdrop').forEach(function(bd) {
    bd.addEventListener('click', function(e) {
      if (e.target === bd) bd.classList.remove('open');
    });
  });

  function openAddProductModal() {
    document.getElementById('add-product-modal').classList.add('open');
    document.getElementById('product-search-input').value = '';
    document.getElementById('selected-product-id').value = '';
    document.getElementById('selected-product-label').style.display = 'none';
    document.getElementById('product-list').style.display = 'none';
    setTimeout(function() { document.getElementById('product-search-input').focus(); }, 100);
  }

  function closeAddProductModal() {
    document.getElementById('add-product-modal').classList.remove('open');
  }

  function selectProduct(id, nombre, codigo) {
    document.getElementById('selected-product-id').value = id;
    var lbl = nombre + ' (' + codigo + ')';
    document.getElementById('product-search-input').value = lbl;
    var labelEl = document.getElementById('selected-product-label');
    // Use textContent — never innerHTML — to avoid XSS
    labelEl.textContent = 'Seleccionado: ' + lbl;
    labelEl.style.display = 'block';
    document.getElementById('product-list').style.display = 'none';
  }

  var searchInput = document.getElementById('product-search-input');
  var productList = document.getElementById('product-list');

  searchInput.addEventListener('input', function() {
    var q = this.value.toLowerCase().trim();
    // Clear previous results using DOM (never innerHTML with user data)
    while (productList.firstChild) productList.removeChild(productList.firstChild);
    if (!q) { productList.style.display = 'none'; return; }

    var matches = allProducts.filter(function(p) {
      return p.nombre.toLowerCase().includes(q) ||
             (p.codigo_prod && p.codigo_prod.toLowerCase().includes(q));
    }).slice(0, 20);

    if (!matches.length) {
      var empty = document.createElement('div');
      empty.style.cssText = 'padding:10px 14px;color:#a0aec0;font-size:13px;';
      empty.textContent = 'Sin resultados';
      productList.appendChild(empty);
    } else {
      matches.forEach(function(p) {
        var item = document.createElement('div');
        item.style.cssText = 'padding:9px 14px;cursor:pointer;font-size:13px;border-bottom:1px solid #f0f4f8;';
        item.addEventListener('mouseover', function() { this.style.background = '#f7fafc'; });
        item.addEventListener('mouseout', function() { this.style.background = ''; });
        item.addEventListener('click', function() { selectProduct(p.id, p.nombre, p.codigo_prod); });
        // Build label safely with DOM text nodes
        var strong = document.createElement('strong');
        strong.textContent = p.nombre;
        var code = document.createElement('span');
        code.style.color = '#a0aec0';
        code.textContent = ' (' + p.codigo_prod + ')';
        item.appendChild(strong);
        item.appendChild(code);
        productList.appendChild(item);
      });
    }
    productList.style.display = 'block';
  });

  // Hide dropdown when clicking outside
  document.addEventListener('click', function(e) {
    if (!document.getElementById('product-dropdown').contains(e.target) && e.target !== searchInput) {
      productList.style.display = 'none';
    }
  });
</script>

<%- include('../partials/footer') %>
