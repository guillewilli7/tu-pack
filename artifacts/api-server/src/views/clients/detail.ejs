<%- include('../partials/header', { title: 'Cliente: ' + client.nombre, page: 'clients', nombre }) %>

<div class="flex gap-2 items-center" style="margin-bottom:20px;">
  <a href="/clients" class="btn btn-secondary btn-sm">← Volver</a>
  <form method="POST" action="/clients/<%= client.id %>/deactivate" style="margin-left:auto;" data-name="<%= client.nombre %>">
    <button type="submit" class="btn btn-sm btn-danger"
      onclick="return confirm('¿Desactivar a ' + this.closest('form').dataset.name + '?')">Desactivar cliente</button>
  </form>
</div>

<% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card section">
  <div class="card-header"><span class="card-title">Datos del cliente</span></div>
  <div class="card-body">
    <form method="POST" action="/clients/<%= client.id %>/update">
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Nombre</label>
          <input class="form-control" name="nombre" value="<%= client.nombre %>" required />
        </div>
        <div class="form-group">
          <label class="form-label">Estado</label>
          <select class="form-control" name="activo">
            <option value="true"  <%= client.activo ? 'selected' : '' %>>Activo</option>
            <option value="false" <%= !client.activo ? 'selected' : '' %>>Inactivo</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Notas</label>
        <textarea class="form-control" name="notas" rows="2" style="resize:vertical;"><%= client.notas || '' %></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Guardar cambios</button>
    </form>
  </div>
</div>

<!-- ── Productos y stock ────────────────────────────────────────────────── -->
<div class="card section">
  <div class="card-header">
    <span class="card-title">Productos y stock (<%= clientProducts.length %>)</span>
    <button class="btn btn-primary btn-sm" onclick="document.getElementById('add-product-modal').classList.add('open')">+ Agregar producto</button>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Producto</th>
          <th style="width:150px;">Precio</th>
          <th style="width:260px;">Stock / mínimo</th>
          <th style="width:70px;"></th>
        </tr>
      </thead>
      <tbody>
        <% if (!clientProducts.length) { %>
          <tr><td colspan="4" class="table-empty">Este cliente todavía no tiene productos.</td></tr>
        <% } %>
        <% clientProducts.forEach(function(p) { %>
          <% var bajoMinimo = p.stock_minimo !== null && p.stock <= p.stock_minimo; %>
          <tr>
            <td>
              <strong><%= p.nombre %></strong>
              <span class="text-muted"><%= p.codigo_prod || '' %></span>
              <% if (p.notas) { %><div class="text-muted"><%= p.notas %></div><% } %>
            </td>
            <td>
              <form method="POST" action="/clients/<%= client.id %>/products/update-price" class="inline-form">
                <input type="hidden" name="bp_id" value="<%= p.bp_id %>" />
                <input type="number" step="0.01" name="precio" class="form-control"
                       value="<%= p.precio === null ? '' : Number(p.precio).toFixed(2) %>" placeholder="a definir" style="width:90px;" />
                <button type="submit" class="btn btn-sm btn-secondary">OK</button>
              </form>
            </td>
            <td>
              <form method="POST" action="/clients/<%= client.id %>/products/update-stock" class="inline-form">
                <input type="hidden" name="product_id" value="<%= p.product_id %>" />
                <input type="number" name="stock" class="form-control" value="<%= p.stock %>"
                       style="width:100px;<%= p.stock < 0 ? 'border-color:var(--destructive);color:var(--destructive);font-weight:600;' : '' %>" />
                <input type="number" name="stock_minimo" class="form-control"
                       value="<%= p.stock_minimo === null ? '' : p.stock_minimo %>" placeholder="mínimo" style="width:90px;" />
                <button type="submit" class="btn btn-sm btn-secondary">Guardar</button>
                <% if (p.stock < 0) { %><span class="badge badge-red">faltan <%= Math.abs(p.stock) %></span>
                <% } else if (bajoMinimo) { %><span class="badge badge-yellow">bajo mínimo</span><% } %>
              </form>
            </td>
            <td>
              <form method="POST" action="/clients/<%= client.id %>/products/<%= p.bp_id %>/remove" data-name="<%= p.nombre %>">
                <button type="submit" class="btn btn-sm btn-secondary"
                  onclick="return confirm('¿Quitar ' + this.closest('form').dataset.name + ' de este cliente?')">Quitar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- ── Sucursales ──────────────────────────────────────────────────────── -->
<div class="card section">
  <div class="card-header">
    <span class="card-title">Sucursales y facturación (<%= branches.length %>)</span>
    <button class="btn btn-primary btn-sm" onclick="document.getElementById('add-branch-modal').classList.add('open')">+ Agregar sucursal</button>
  </div>
  <div class="card-body branch-list">
    <% if (!branches.length) { %>
      <p class="text-muted">Este cliente no tiene sucursales cargadas.</p>
    <% } %>
    <% branches.forEach(function(b, i) { %>
      <% var tels = phones.filter(function(t) { return t.client_id === b.id && t.activo; }); %>
      <details class="branch" <%= branches.length === 1 ? 'open' : '' %>>
        <summary class="branch-summary">
          <span class="branch-chevron">▶</span>
          <span class="branch-name"><%= b.sucursal || 'Sucursal única' %></span>
          <% if (!b.activo) { %><span class="badge badge-red">Inactiva</span><% } %>
          <% if (!b.rut) { %><span class="badge badge-yellow">sin facturación</span><% } %>
          <span class="branch-meta">
            <%= [b.rut ? 'RUT ' + b.rut : null, b.direccion_entrega,
                 tels.length ? tels.length + (tels.length === 1 ? ' teléfono' : ' teléfonos') : null]
                .filter(Boolean).join(' · ') || 'sin datos cargados' %>
          </span>
        </summary>

        <div class="branch-body">
      <form method="POST" action="/clients/<%= client.id %>/branches/<%= b.id %>/update">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Sucursal</label>
            <input class="form-control" name="sucursal" value="<%= b.sucursal || '' %>" placeholder="(única)" />
          </div>
          <div class="form-group">
            <label class="form-label">Estado</label>
            <select class="form-control" name="activo">
              <option value="true"  <%= b.activo ? 'selected' : '' %>>Activa</option>
              <option value="false" <%= !b.activo ? 'selected' : '' %>>Inactiva</option>
            </select>
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Razón social</label>
            <input class="form-control" name="razon_social" value="<%= b.razon_social || '' %>" />
          </div>
          <div class="form-group">
            <label class="form-label">RUT</label>
            <input class="form-control" name="rut" value="<%= b.rut || '' %>" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Dirección de facturación</label>
            <input class="form-control" name="direccion_facturacion" value="<%= b.direccion_facturacion || '' %>" />
          </div>
          <div class="form-group">
            <label class="form-label">Dirección de entrega</label>
            <input class="form-control" name="direccion_entrega" value="<%= b.direccion_entrega || '' %>" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Horario de entrega</label>
            <input class="form-control" name="horario_entrega" value="<%= b.horario_entrega || '' %>" />
          </div>
          <div class="form-group">
            <label class="form-label">Observaciones</label>
            <input class="form-control" name="info_cliente" value="<%= (b.info_cliente || '').replace(/\n/g, ' · ') %>" />
          </div>
        </div>
        <div class="flex gap-2 items-center">
          <button type="submit" class="btn btn-primary btn-sm">Guardar sucursal</button>
          <span class="text-muted">
            Teléfonos: <%= tels.length ? tels.map(function(t) { return t.phone + (t.label ? ' (' + t.label + ')' : ''); }).join(' · ') : 'sin teléfonos' %>
          </span>
        </div>
      </form>

          <div class="inline-form" style="margin-top:14px;">
            <form method="POST" action="/clients/<%= client.id %>/phones/add" class="inline-form">
              <input type="hidden" name="client_id" value="<%= b.id %>" />
              <input class="form-control" name="phone" placeholder="Teléfono" style="width:150px;" required />
              <input class="form-control" name="label" placeholder="Etiqueta" style="width:130px;" />
              <button type="submit" class="btn btn-sm btn-secondary">+ Teléfono</button>
            </form>
          </div>
        </div>
      </details>
    <% }) %>
  </div>
</div>

<!-- ── Últimas órdenes ─────────────────────────────────────────────────── -->
<div class="card section">
  <div class="card-header"><span class="card-title">Últimas órdenes</span></div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th style="width:80px;">#</th><th style="width:130px;">Fecha</th><th>Sucursal</th><th style="width:140px;">Estado</th><th style="width:120px;">Total</th></tr>
      </thead>
      <tbody>
        <% if (!orders.length) { %>
          <tr><td colspan="5" class="table-empty">Todavía no hay órdenes de este cliente.</td></tr>
        <% } %>
        <% orders.forEach(function(o) { %>
          <tr style="cursor:pointer;" onclick="window.location='/orders/<%= o.id %>'">
            <td class="text-muted"><%= o.id %></td>
            <td><%= new Date(o.created_at).toLocaleDateString('es-UY') %></td>
            <td><%= o.sucursal || '—' %></td>
            <td>
              <% if (o.status === 'pendiente') { %><span class="badge badge-yellow">Pendiente</span>
              <% } else if (o.status === 'en_proceso') { %><span class="badge badge-blue">En proceso</span>
              <% } else if (o.status === 'cancelado') { %><span class="badge badge-red">Cancelada</span>
              <% } else { %><span class="badge badge-green"><%= o.status %></span><% } %>
            </td>
            <td>$<%= Number(o.total || 0).toFixed(2) %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<!-- Modales -->
<div class="modal-backdrop" id="add-product-modal">
  <div class="modal">
    <h3>Agregar producto</h3>
    <form method="POST" action="/clients/<%= client.id %>/products/add">
      <div class="form-group">
        <label class="form-label">Producto</label>
        <select name="product_id" class="form-control" required>
          <option value="">Elegí un producto…</option>
          <% allProducts.forEach(function(p) { %>
            <option value="<%= p.id %>"><%= p.nombre %><%= p.codigo_prod ? ' — ' + p.codigo_prod : '' %></option>
          <% }) %>
        </select>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="form-label">Precio</label>
          <input type="number" step="0.01" name="precio" class="form-control" placeholder="a definir" />
        </div>
        <div class="form-group">
          <label class="form-label">Stock inicial</label>
          <input type="number" name="stock" class="form-control" value="0" />
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('add-product-modal').classList.remove('open')">Cancelar</button>
        <button type="submit" class="btn btn-primary">Agregar</button>
      </div>
    </form>
  </div>
</div>

<div class="modal-backdrop" id="add-branch-modal">
  <div class="modal">
    <h3>Agregar sucursal</h3>
    <form method="POST" action="/clients/<%= client.id %>/branches/add">
      <div class="form-group">
        <label class="form-label">Nombre de la sucursal</label>
        <input class="form-control" name="sucursal" placeholder="Ej: POCITOS" />
        <p class="text-muted mt-1">Los datos de facturación se completan después, en la ficha.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="document.getElementById('add-branch-modal').classList.remove('open')">Cancelar</button>
        <button type="submit" class="btn btn-primary">Agregar</button>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>
