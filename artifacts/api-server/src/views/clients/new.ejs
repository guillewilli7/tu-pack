<%- include('../partials/header', { title: 'Nuevo cliente', page: 'clients', nombre }) %>

<div style="margin-bottom:20px;">
  <a href="/clients" class="btn btn-secondary btn-sm">← Volver</a>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<form method="POST" action="/clients/new">
  <div class="card section" style="max-width:640px;">
    <div class="card-header"><span class="card-title">Datos del cliente</span></div>
    <div class="card-body">
      <div class="form-group">
        <label class="form-label" for="nombre">Nombre <span style="color:var(--destructive);">*</span></label>
        <input class="form-control" type="text" id="nombre" name="nombre" required placeholder="Ej: GARAGE BURGER" />
        <p class="text-muted mt-1">
          El cliente es el negocio: sus productos y su stock cuelgan de acá. Las sucursales,
          con sus datos de facturación, se agregan después desde la ficha.
        </p>
      </div>
      <div class="form-group">
        <label class="form-label" for="notas">Notas</label>
        <textarea class="form-control" id="notas" name="notas" rows="3" style="resize:vertical;"></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Crear cliente</button>
    </div>
  </div>
</form>

<%- include('../partials/footer') %>
