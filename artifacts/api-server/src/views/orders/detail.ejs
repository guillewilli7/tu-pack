<%- include('../partials/header', { title: 'Detalle de Orden #' + order.id, page: 'orders', nombre }) %>

<div class="flex gap-2 items-center" style="margin-bottom:20px;">
  <a href="/orders" class="btn btn-secondary btn-sm">← Volver</a>
</div>

<% if (success) { %><div class="alert alert-success">Orden actualizada correctamente.</div><% } %>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<%
  var isCompleted = order.status === 'completada' || order.status === 'confirmado';
  var isCancelled = order.status === 'cancelado';
  var isInProcess = order.status === 'en_proceso';
  var isPending   = order.status === 'pendiente';
  var canAdvance  = isPending || isInProcess;
  var canCancel   = !isCancelled;
  var advanceLabel = isPending ? 'Marcar En Proceso' : 'Marcar Completada';
%>

<div class="section grid-2">
  <div class="card">
    <div class="card-header"><span class="card-title">Información</span></div>
    <div class="card-body">
      <table style="font-size:14px;width:100%;border-collapse:collapse;">
        <tr><td style="padding:6px 0;color:#5a6b80;width:140px;">ID</td><td><strong>#<%= order.id %></strong></td></tr>
        <tr><td style="padding:6px 0;color:#5a6b80;">Fecha</td><td><%= new Date(order.created_at).toLocaleString('es-UY') %></td></tr>
        <tr><td style="padding:6px 0;color:#5a6b80;">Negocio</td><td><%= order.negocio || order.client_negocio || '—' %></td></tr>
        <tr><td style="padding:6px 0;color:#5a6b80;">Teléfono</td><td><%= order.phone || '—' %></td></tr>
        <tr><td style="padding:6px 0;color:#5a6b80;">Cliente</td><td><% if (order.client_id) { %><a href="/clients/<%= order.client_id %>" class="btn-link"><%= order.client_negocio || order.codigo_cliente || order.client_id %></a><% } else { %>—<% } %></td></tr>
        <tr><td style="padding:6px 0;color:#5a6b80;">Estado</td>
          <td>
            <% if (isPending) { %><span class="badge badge-yellow">Pendiente</span>
            <% } else if (isInProcess) { %><span class="badge badge-blue">En Proceso</span>
            <% } else if (isCompleted) { %><span class="badge badge-green">Completada</span>
            <% } else if (isCancelled) { %><span class="badge badge-red">Cancelada</span>
            <% } else { %><span class="badge badge-gray"><%= order.status %></span><% } %>
          </td>
        </tr>
        <tr><td style="padding:6px 0;color:#5a6b80;">Total</td><td><strong>$<%= Number(order.total || 0).toFixed(2) %></strong></td></tr>
        <% if (order.raw_data && order.raw_data.notas) { %>
        <tr><td style="padding:6px 0;color:#5a6b80;vertical-align:top;">Notas</td><td style="white-space:pre-wrap;"><%= order.raw_data.notas %></td></tr>
        <% } %>
      </table>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><span class="card-title">Acciones</span></div>
    <div class="card-body">

      <% if (canAdvance) { %>
      <form method="POST" action="/orders/<%= order.id %>" style="margin-bottom:12px;">
        <button type="submit" name="action" value="advance" class="btn btn-primary" style="width:100%;">
          ▶ <%= advanceLabel %>
        </button>
      </form>
      <% } %>

      <% if (isCompleted) { %>
      <form method="POST" action="/orders/<%= order.id %>" style="margin-bottom:12px;">
        <button type="submit" name="action" value="cancel"
          class="btn btn-danger" style="width:100%;"
          onclick="return confirm('¿Cancelar esta orden?')">
          ✕ Cancelar orden
        </button>
      </form>
      <% } %>

      <% if (canCancel && !isCompleted) { %>
      <form method="POST" action="/orders/<%= order.id %>" style="margin-bottom:12px;">
        <button type="submit" name="action" value="cancel"
          class="btn btn-danger" style="width:100%;"
          onclick="return confirm('¿Cancelar esta orden?')">
          ✕ Cancelar orden
        </button>
      </form>
      <% } %>

      <% if (isCancelled) { %>
      <form method="POST" action="/orders/<%= order.id %>" style="margin-bottom:12px;">
        <button type="submit" name="action" value="reopen" class="btn btn-secondary" style="width:100%;">
          ↺ Volver a Pendiente
        </button>
      </form>
      <% } %>

      <hr style="border:none;border-top:1px solid #e3e8ef;margin:16px 0;" />

      <form method="POST" action="/orders/<%= order.id %>">
        <div class="form-group">
          <label class="form-label">Total ($)</label>
          <input type="number" name="total" step="0.01" class="form-control" value="<%= order.total || 0 %>" />
        </div>
        <button type="submit" name="action" value="update_total" class="btn btn-secondary">Actualizar total</button>
      </form>

    </div>
  </div>
</div>

<div class="card section">
  <div class="card-header"><span class="card-title">Artículos del pedido</span></div>
  <div class="table-wrap">
    <% const items = order.items; %>
    <% if (!items || (Array.isArray(items) && !items.length)) { %>
      <div class="table-empty">No hay artículos registrados.</div>
    <% } else { %>
      <table>
        <thead>
          <tr>
            <th>Producto</th>
            <th>Cantidad</th>
            <th>Precio unit.</th>
            <th>Subtotal</th>
            <th>Notas</th>
          </tr>
        </thead>
        <tbody>
          <% const itemList = Array.isArray(items) ? items : (typeof items === 'object' ? Object.values(items) : []); %>
          <% itemList.forEach(function(item) { %>
            <% var nombre = item.nombre_pedido || item.nombre_catalogo || item.nombre || item.name || item.producto || '—'; %>
            <% var codigo = item.codigo_prod || item.codigo || ''; %>
            <% var cantidad = item.cantidad || item.qty || item.quantity || '—'; %>
            <% var precioUnit = item.precio_unitario || item.precio || item.price || null; %>
            <% var subtotal = item.subtotal || null; %>
            <tr>
              <td><strong><%= nombre %></strong><% if (codigo) { %> <span class="text-muted" style="font-size:12px;"><%= codigo %></span><% } %></td>
              <td><%= cantidad %></td>
              <td><%= precioUnit !== null ? '$' + Number(precioUnit).toFixed(2) : '—' %></td>
              <td><%= subtotal !== null ? '$' + Number(subtotal).toFixed(2) : '—' %></td>
              <td class="text-muted"><%= item.notas || item.notes || '' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </div>
</div>

<% if (order.raw_data && Object.keys(order.raw_data).length > 0) { %>
<div class="card">
  <div class="card-header">
    <span class="card-title">Datos crudos</span>
    <button class="btn btn-sm btn-secondary" onclick="document.getElementById('raw-data').style.display=document.getElementById('raw-data').style.display==='none'?'block':'none'">Mostrar / Ocultar</button>
  </div>
  <div class="card-body" id="raw-data" style="display:none;">
    <pre style="font-size:12px;background:#f0f3f8;padding:16px;border-radius:8px;overflow-x:auto;white-space:pre-wrap;word-break:break-all;"><%= JSON.stringify(order.raw_data, null, 2) %></pre>
  </div>
</div>
<% } %>

<%- include('../partials/footer') %>
