<%- include('../partials/header', { title: 'Órdenes', page: 'orders', nombre }) %>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card section">
  <div class="card-header">
    <span class="card-title">Filtros</span>
  </div>
  <div class="card-body">
    <form method="GET" action="/orders">
      <div class="filter-bar">
        <div class="form-group">
          <label class="form-label">Estado</label>
          <select name="status" class="form-control">
            <option value="all" <%= filter.status === 'all' ? 'selected' : '' %>>Todos</option>
            <option value="pendiente" <%= filter.status === 'pendiente' ? 'selected' : '' %>>Pendiente</option>
            <option value="confirmado" <%= filter.status === 'confirmado' ? 'selected' : '' %>>Confirmado</option>
            <option value="cancelado" <%= filter.status === 'cancelado' ? 'selected' : '' %>>Cancelado</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Desde</label>
          <input type="date" name="from" class="form-control" value="<%= filter.from %>" />
        </div>
        <div class="form-group">
          <label class="form-label">Hasta</label>
          <input type="date" name="to" class="form-control" value="<%= filter.to %>" />
        </div>
        <div class="form-group">
          <button type="submit" class="btn btn-primary">Filtrar</button>
          <a href="/orders" class="btn btn-secondary" style="margin-left:8px;">Limpiar</a>
        </div>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header">
    <span class="card-title">Órdenes (<%= orders.length %>)</span>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Fecha</th>
          <th>Negocio</th>
          <th>Estado</th>
          <th>Total</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!orders.length) { %>
          <tr><td colspan="6" class="table-empty">No se encontraron órdenes.</td></tr>
        <% } %>
        <% orders.forEach(function(o) { %>
          <tr>
            <td class="text-muted"><%= o.id %></td>
            <td><%= new Date(o.created_at).toLocaleDateString('es-UY', {day:'2-digit',month:'2-digit',year:'numeric'}) %></td>
            <td><strong><%= o.negocio || o.client_negocio || '—' %></strong></td>
            <td>
              <% if (o.status === 'pendiente') { %>
                <span class="badge badge-yellow">Pendiente</span>
              <% } else if (o.status === 'confirmado') { %>
                <span class="badge badge-green">Confirmado</span>
              <% } else if (o.status === 'cancelado') { %>
                <span class="badge badge-red">Cancelado</span>
              <% } else { %>
                <span class="badge badge-gray"><%= o.status %></span>
              <% } %>
            </td>
            <td>$<%= o.total ? Number(o.total).toFixed(2) : '0.00' %></td>
            <td><a href="/orders/<%= o.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
