<%- include('../partials/header', { title: 'Órdenes', page: 'orders', nombre }) %>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<div class="card section">
  <div class="card-header">
    <span class="card-title">Filtros</span>
  </div>
  <div class="card-body">
    <form method="GET" action="/orders">
      <div class="filter-bar">
        <div class="form-group">
          <label class="form-label">Estado</label>
          <select name="status" class="form-control">
            <option value="all"        <%= filter.status === 'all'        ? 'selected' : '' %>>Todos</option>
            <option value="pendiente"  <%= filter.status === 'pendiente'  ? 'selected' : '' %>>Pendiente</option>
            <option value="en_proceso" <%= filter.status === 'en_proceso' ? 'selected' : '' %>>En Proceso</option>
            <option value="completada" <%= filter.status === 'completada' ? 'selected' : '' %>>Completada</option>
            <option value="cancelado"  <%= filter.status === 'cancelado'  ? 'selected' : '' %>>Cancelada</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Desde</label>
          <input type="date" name="from" class="form-control" value="<%= filter.from %>" />
        </div>
        <div class="form-group">
          <label class="form-label">Hasta</label>
          <input type="date" name="to" class="form-control" value="<%= filter.to %>" />
        </div>
        <div class="form-group">
          <button type="submit" class="btn btn-primary">Filtrar</button>
          <a href="/orders" class="btn btn-secondary" style="margin-left:8px;">Limpiar</a>
        </div>
      </div>
    </form>
  </div>
</div>

<div class="card">
  <div class="card-header" style="display:flex;align-items:center;justify-content:space-between;">
    <span class="card-title">
      Órdenes (<%= pagination.totalCount %>)
      <% if (pagination.totalPages > 1) { %>
        <span class="text-muted" style="font-size:12px;margin-left:8px;">
          Página <%= pagination.currentPage %> de <%= pagination.totalPages %>
        </span>
      <% } %>
    </span>
    <a href="/orders/new" class="btn btn-primary btn-sm">+ Nueva orden</a>
  </div>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Fecha</th>
          <th>Negocio</th>
          <th>Estado</th>
          <th>Total</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% if (!orders.length) { %>
          <tr><td colspan="6" class="table-empty">No se encontraron órdenes.</td></tr>
        <% } %>
        <% orders.forEach(function(o) { %>
          <tr style="cursor:pointer;" onclick="window.location='/orders/<%= o.id %>'">
            <td class="text-muted"><%= o.id %></td>
            <td><%= new Date(o.created_at).toLocaleDateString('es-UY', {day:'2-digit',month:'2-digit',year:'numeric'}) %></td>
            <td><strong><%= o.negocio || o.client_negocio || '—' %></strong></td>
            <td>
              <% if (o.status === 'pendiente') { %>
                <span class="badge badge-yellow">Pendiente</span>
              <% } else if (o.status === 'en_proceso') { %>
                <span class="badge badge-blue">En Proceso</span>
              <% } else if (o.status === 'completada' || o.status === 'confirmado') { %>
                <span class="badge badge-green">Completada</span>
              <% } else if (o.status === 'cancelado') { %>
                <span class="badge badge-red">Cancelada</span>
              <% } else { %>
                <span class="badge badge-gray"><%= o.status %></span>
              <% } %>
            </td>
            <td>$<%= o.total ? Number(o.total).toFixed(2) : '0.00' %></td>
            <td onclick="event.stopPropagation()"><a href="/orders/<%= o.id %>" class="btn btn-sm btn-secondary">Ver</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <% if (pagination.totalPages > 1) { %>
  <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-top:1px solid #e3e8ef;">
    <span class="text-muted">
      <%= ((pagination.currentPage - 1) * pagination.pageSize) + 1 %>–<%= Math.min(pagination.currentPage * pagination.pageSize, pagination.totalCount) %> de <%= pagination.totalCount %>
    </span>
    <div style="display:flex;gap:6px;">
      <% if (pagination.currentPage > 1) { %>
        <a href="?status=<%= filter.status %>&from=<%= filter.from %>&to=<%= filter.to %>&page=<%= pagination.currentPage - 1 %>" class="btn btn-sm btn-secondary">← Anterior</a>
      <% } %>
      <% for (let p = Math.max(1, pagination.currentPage - 2); p <= Math.min(pagination.totalPages, pagination.currentPage + 2); p++) { %>
        <a href="?status=<%= filter.status %>&from=<%= filter.from %>&to=<%= filter.to %>&page=<%= p %>"
           class="btn btn-sm <%= p === pagination.currentPage ? 'btn-primary' : 'btn-secondary' %>"><%= p %></a>
      <% } %>
      <% if (pagination.currentPage < pagination.totalPages) { %>
        <a href="?status=<%= filter.status %>&from=<%= filter.from %>&to=<%= filter.to %>&page=<%= pagination.currentPage + 1 %>" class="btn btn-sm btn-secondary">Siguiente →</a>
      <% } %>
    </div>
  </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
